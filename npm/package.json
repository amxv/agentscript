{
  "name": "@amxv/agentscript",
  "version": "0.3.1",
  "description": "Agent handoff, history search, and readable Claude Code/Codex transcript CLI",
  "license": "MIT",
  "author": "amxv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amxv/agentscript.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/amxv/agentscript#readme",
  "bugs": {
    "url": "https://github.com/amxv/agentscript/issues"
  },
  "bin": {
    "agentscript": "bin/agentscript.js"
  },
  "config": {
    "cliBinaryName": "agentscript"
  },
  "files": [
    "bin/agentscript.js",
    "scripts/postinstall.js",
    "cmd",
    "internal",
    "go.mod",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "test": "node --check bin/agentscript.js && node --check scripts/postinstall.js && node --test scripts/prepare-package.test.mjs",
    "lint": "npm run test",
    "prepare:package": "node scripts/prepare-package.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "codex",
    "jsonl",
    "transcript",
    "handoff",
    "context-transfer",
    "cli",
    "agent"
  ]
}
