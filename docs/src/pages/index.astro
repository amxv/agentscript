---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const signals = [
  ["02", "providers", "Claude Code + Codex"],
  ["∞", "stable addresses", "Filters never renumber"],
  ["01", "binary", "Go, standard library only"],
  ["06", "output views", "Text, Markdown, HTML, JSON"]
];

const flows = [
  {
    index: "#003",
    kind: "COMMAND · BASH",
    text: "agentscript search \"publish-pr\" --provider codex",
    note: "Find the exact moment across recent sessions."
  },
  {
    index: "#007",
    kind: "OPEN · CONTEXT",
    text: "agentscript open session.jsonl --around 342",
    note: "Jump back in with the surrounding decisions intact."
  },
  {
    index: "#012",
    kind: "EXPORT · HANDOFF",
    text: "agentscript export session.jsonl --profile handoff --out context.md",
    note: "Carry signal forward without carrying the entire log."
  }
];
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <main class="as-page">
    <section class="as-hero shell">
      <div class="as-hero__grid" aria-hidden="true"></div>
      <div class="as-hero__glow" aria-hidden="true"></div>

      <div class="as-hero__topline as-reveal">
        <span class="as-status"><i></i> LOCAL TRANSCRIPT INDEX / READY</span>
        <span>CLAUDE CODE · CODEX · JSONL</span>
      </div>

      <div class="as-hero__layout">
        <div class="as-hero__copy">
          <p class="as-kicker as-reveal">Your agent did the work. Keep the part that matters.</p>
          <h1 class="as-reveal as-delay-1">
            Turn agent logs into
            <span>usable memory.</span>
          </h1>
          <p class="as-hero__lede as-reveal as-delay-2">
            <strong>agentscript</strong> reads Claude Code and Codex transcripts as one stream of stable,
            searchable blocks—then slices away the noise and exports exactly the context your next agent needs.
          </p>
          <div class="as-actions as-reveal as-delay-3">
            <a class="as-button as-button--primary" href="/docs/quickstart">
              <span>Install agentscript</span><b>↗</b>
            </a>
            <a class="as-button as-button--quiet" href="https://github.com/amxv/agentscript">
              View source <span>↗</span>
            </a>
          </div>
          <div class="as-install as-reveal as-delay-4">
            <span class="as-install__prompt">$</span>
            <code>npm i -g @amxv/agentscript</code>
            <button class="as-copy" data-copy="npm i -g @amxv/agentscript" aria-label="Copy install command">COPY</button>
          </div>
        </div>

        <div class="as-terminal-wrap as-reveal as-delay-2">
          <div class="as-terminal-shadow"></div>
          <div class="as-terminal">
            <div class="as-terminal__bar">
              <div class="as-dots"><i></i><i></i><i></i></div>
              <span>handoff.md — agentscript</span>
              <span>84 × 28</span>
            </div>
            <div class="as-terminal__body">
              <div class="as-line as-line--meta"><b>#000</b><span>USER</span><time>10:42:07</time></div>
              <p>Redesign the landing page and push it to main.</p>

              <div class="as-line as-line--dim"><b>#001</b><span>THINKING</span><em>hidden by profile</em></div>

              <div class="as-line as-line--agent"><b>#002</b><span>ASSISTANT</span><time>10:42:14</time></div>
              <p>I’ll inspect the product, build a focused visual system, and verify the result.</p>

              <div class="as-line as-line--command"><b>#003</b><span>COMMAND · BASH</span><time>10:42:21</time></div>
              <pre><code>git status --short && bun run docs:build</code></pre>

              <div class="as-result">
                <span>✓</span>
                <div><b>Build complete</b><small>exited 0 · 2.4s</small></div>
              </div>

              <div class="as-line as-line--agent"><b>#007</b><span>ASSISTANT</span><time>10:42:29</time></div>
              <p>The transcript became a handoff. The missing indexes are the point.</p>
              <div class="as-cursor"><span>█</span> ready</div>
            </div>
          </div>
          <div class="as-terminal-tag">STABLE BLOCK ADDRESSING</div>
        </div>
      </div>

      <div class="as-signal-grid as-reveal as-delay-4">
        {signals.map(([value, label, detail]) => (
          <article>
            <strong>{value}</strong>
            <div><span>{label}</span><p>{detail}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="as-manifesto shell">
      <div class="as-section-number">01 / THE PROBLEM</div>
      <div class="as-manifesto__copy">
        <p class="as-eyebrow">RAW JSONL IS A RECORD, NOT A HANDOFF</p>
        <h2>An hour of work should not cost another agent an hour of context.</h2>
      </div>
      <div class="as-manifesto__body">
        <p>
          Agent transcripts are full of valuable decisions buried beneath thinking blocks, tool plumbing,
          repeated results, and provider-specific schemas. Passing the raw file forward wastes the very
          context window you are trying to preserve.
        </p>
        <p>
          agentscript normalizes the session once, gives every meaningful block a permanent address,
          and lets you subtract everything the next reader does not need.
        </p>
      </div>
    </section>

    <section class="as-workflow shell">
      <header class="as-section-head">
        <div>
          <span class="as-section-number">02 / THE WORKFLOW</span>
          <p class="as-eyebrow">FIND → OPEN → CARRY FORWARD</p>
        </div>
        <h2>Context extraction with receipts.</h2>
      </header>

      <div class="as-flow-list">
        {flows.map((flow, i) => (
          <article class="as-flow">
            <div class="as-flow__rail">
              <span>{flow.index}</span>
              {i < flows.length - 1 && <i></i>}
            </div>
            <div class="as-flow__content">
              <small>{flow.kind}</small>
              <code>{flow.text}</code>
              <p>{flow.note}</p>
            </div>
            <span class="as-flow__step">0{i + 1}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="as-feature shell">
      <div class="as-feature__statement">
        <span class="as-section-number">03 / WHY THE GAPS MATTER</span>
        <p class="as-eyebrow">AN INDEX IS AN ADDRESS, NOT A COUNTER</p>
        <h2><span>#003</span> stays <span>#003</span>, even when everything around it disappears.</h2>
        <p>
          Hide thinking. Filter to Bash. Render messages only. The visible sequence can change,
          but every block keeps the address it received at parse time. Search results, slices, and handoffs stay valid.
        </p>
      </div>
      <div class="as-index-demo" aria-label="Stable index filtering demonstration">
        <div class="as-index-demo__head"><span>FULL SESSION</span><span>HANDOFF PROFILE</span></div>
        {[
          ["#003", "USER", true],
          ["#004", "THINKING", false],
          ["#005", "TOOL CALL", false],
          ["#006", "TOOL RESULT", false],
          ["#007", "ASSISTANT", true],
          ["#008", "COMMAND", true],
          ["#009", "COMMAND RESULT", false],
          ["#012", "ASSISTANT", true]
        ].map(([index, kind, visible]) => (
          <div class:list={["as-index-row", !visible && "is-muted"]}>
            <code>{index}</code><span>{kind}</span><i></i><b>{visible ? index : "—"}</b>
          </div>
        ))}
      </div>
    </section>

    <section class="as-docs shell">
      <header class="as-section-head">
        <div>
          <span class="as-section-number">04 / DOCUMENTATION</span>
          <p class="as-eyebrow">SMALL TOOL. COMPLETE MAP.</p>
        </div>
        <h2>From first transcript to exact handoff.</h2>
      </header>
      <div class="as-docs__grid">
        {docs.map((entry, index) => (
          <a class="as-doc-card" href={`/docs/${entry.id}`}>
            <div class="as-doc-card__top"><span>0{index + 1}</span><b>↗</b></div>
            <small>{entry.data.category}</small>
            <h3>{entry.data.title}</h3>
            <p>{entry.data.summary ?? entry.data.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="as-cta shell">
      <div class="as-cta__scan" aria-hidden="true"></div>
      <span class="as-section-number">05 / START HERE</span>
      <h2>Stop pasting the whole session.</h2>
      <p>Give the next agent the decisions, the commands, and nothing it has to rediscover.</p>
      <div class="as-actions">
        <a class="as-button as-button--primary" href="/docs/quickstart">Read the quickstart <b>↗</b></a>
        <a class="as-button as-button--quiet" href="/docs/command-reference">Explore every command</a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.textContent = "COPIED";
      window.setTimeout(() => (button.textContent = "COPY"), 1400);
    });
  });
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap');

  :root,
  :root[data-theme="light"] {
    --as-ink: #11120f;
    --as-paper: #f2f0e8;
    --as-acid: #d7ff3f;
    --as-cyan: #44d7d2;
    --as-orange: #ff6b35;
    --as-line: rgba(17, 18, 15, .16);
    --as-muted: rgba(17, 18, 15, .69);
    --as-subtle: rgba(17, 18, 15, .6);
    --as-faint: rgba(17, 18, 15, .5);
    --as-ghost: rgba(17, 18, 15, .1);
    --as-quiet-bg: rgba(242, 240, 232, .65);
    --as-panel: #11120f;
    --as-panel-ink: #f2f0e8;
    --as-panel-muted: rgba(242, 240, 232, .62);
    --as-panel-faint: rgba(242, 240, 232, .4);
    --as-acid-ink: #11120f;
    --as-mono: "DM Mono", monospace;
    --as-sans: "Manrope", sans-serif;
    --as-serif: "Instrument Serif", serif;
  }

  :root[data-theme="dark"] {
    --as-ink: #f2f0e8;
    --as-paper: #0d0f0c;
    --as-line: rgba(242, 240, 232, .18);
    --as-muted: rgba(242, 240, 232, .72);
    --as-subtle: rgba(242, 240, 232, .62);
    --as-faint: rgba(242, 240, 232, .5);
    --as-ghost: rgba(242, 240, 232, .12);
    --as-quiet-bg: rgba(255, 255, 255, .055);
    --as-panel: #070806;
    --as-panel-ink: #f2f0e8;
    --as-panel-muted: rgba(242, 240, 232, .66);
    --as-panel-faint: rgba(242, 240, 232, .42);
  }

  html { scroll-behavior: smooth; }
  body { background: var(--as-paper); color: var(--as-ink); font-family: var(--as-sans); }
  .as-page { overflow: hidden; }
  .as-page .shell { max-width: 1240px; }
  .as-section-number, .as-eyebrow, .as-kicker, .as-status { font-family: var(--as-mono); letter-spacing: .09em; text-transform: uppercase; }
  .as-section-number { font-size: .68rem; color: var(--as-faint); }
  .as-eyebrow { font-size: .72rem; margin: 0 0 1.5rem; }

  .as-hero { position: relative; min-height: 820px; padding-top: clamp(2.5rem, 6vw, 5rem); padding-bottom: 2.2rem; isolation: isolate; }
  .as-hero__grid { position: absolute; inset: 0 50% 0 -50vw; width: 150vw; z-index: -2; opacity: .42; background-image: linear-gradient(var(--as-line) 1px, transparent 1px), linear-gradient(90deg, var(--as-line) 1px, transparent 1px); background-size: 64px 64px; mask-image: linear-gradient(to bottom, black 0 72%, transparent 96%); }
  .as-hero__glow { position: absolute; width: 640px; height: 640px; right: -180px; top: 30px; border-radius: 50%; background: var(--as-acid); filter: blur(130px); opacity: .15; z-index: -1; }
  .as-hero__topline { display: flex; justify-content: space-between; align-items: center; padding-bottom: 1.3rem; border-bottom: 1px solid var(--as-line); font: 500 .64rem var(--as-mono); letter-spacing: .08em; }
  .as-status { display: flex; align-items: center; gap: .55rem; }
  .as-status i { width: 7px; height: 7px; background: #56bd39; border-radius: 50%; box-shadow: 0 0 0 5px rgba(86,189,57,.13); }
  .as-hero__layout { display: grid; grid-template-columns: 1.04fr .96fr; gap: clamp(3rem, 7vw, 7rem); align-items: center; padding: clamp(4.5rem, 8vw, 7.5rem) 0 4.5rem; }
  .as-kicker { font-size: .75rem; font-weight: 600; margin-bottom: 1.6rem; }
  .as-hero h1 { max-width: 780px; font: 400 clamp(4.5rem, 8vw, 8rem)/.82 var(--as-serif); letter-spacing: -.055em; margin: 0; }
  .as-hero h1 span { display: block; font-style: italic; color: transparent; -webkit-text-stroke: 1.5px var(--as-ink); }
  .as-hero__lede { max-width: 660px; margin: 2.2rem 0 0; font-size: clamp(1rem, 1.4vw, 1.2rem); line-height: 1.75; color: var(--as-muted); }
  .as-hero__lede strong { color: var(--as-ink); }
  .as-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .as-button { min-height: 50px; display: inline-flex; align-items: center; justify-content: center; gap: 1rem; padding: 0 1.25rem; border: 1px solid var(--as-ink); font: 600 .78rem var(--as-mono); letter-spacing: .025em; transition: transform .2s ease, box-shadow .2s ease, background .2s ease; }
  .as-button:hover { transform: translate(-3px,-3px); }
  .as-button--primary { background: var(--as-ink); color: var(--as-paper); box-shadow: 5px 5px 0 var(--as-acid); }
  .as-button--primary:hover { box-shadow: 8px 8px 0 var(--as-acid); }
  .as-button--quiet { background: var(--as-quiet-bg); }
  .as-install { margin-top: 1.1rem; max-width: 535px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .8rem; border-bottom: 1px solid var(--as-ink); padding: .8rem 0; font: .76rem var(--as-mono); }
  .as-install__prompt { color: var(--as-orange); font-weight: 700; }
  .as-copy { border: 0; background: none; color: inherit; font: 600 .62rem var(--as-mono); cursor: pointer; }

  .as-terminal-wrap { position: relative; transform: rotate(1.7deg); }
  .as-terminal-shadow { position: absolute; inset: 18px -18px -18px 18px; background: var(--as-acid); border: 1px solid var(--as-ink); }
  .as-terminal { position: relative; background: #10120f; color: #e9eadf; border: 1px solid #000; box-shadow: 0 30px 80px rgba(0,0,0,.22); }
  .as-terminal__bar { height: 42px; border-bottom: 1px solid #363830; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 1rem; font: .58rem var(--as-mono); color: #8c8f82; }
  .as-terminal__bar > :last-child { justify-self: end; }
  .as-dots { display: flex; gap: 6px; }.as-dots i { width: 7px; height: 7px; border: 1px solid #777a70; border-radius: 50%; }
  .as-terminal__body { padding: 1.25rem; min-height: 470px; font-family: var(--as-mono); font-size: .68rem; }
  .as-terminal__body p { margin: .55rem 0 1.4rem 2.7rem; line-height: 1.7; color: #c8cabf; }
  .as-line { display: grid; grid-template-columns: 42px 1fr auto; gap: .65rem; align-items: center; margin-top: .55rem; }
  .as-line b { color: var(--as-acid); }.as-line span { font-size: .58rem; letter-spacing: .08em; }.as-line time { color: #62655d; font-size: .54rem; }
  .as-line--dim { opacity: .34; border: 1px dashed #55584f; padding: .5rem; margin: .6rem 0 1.2rem; grid-template-columns: 42px 1fr auto; }.as-line--dim em { font-style: normal; font-size: .5rem; }
  .as-line--command span { color: var(--as-cyan); }
  .as-terminal pre { margin: .6rem 0 .8rem 2.7rem; padding: .8rem; background: #171a16; border-left: 2px solid var(--as-cyan); white-space: pre-wrap; }
  .as-result { margin: 0 0 1.35rem 2.7rem; display: flex; gap: .7rem; align-items: center; color: #a9f28c; }.as-result > span { font-size: 1.2rem; }.as-result b,.as-result small { display:block; }.as-result small { color:#65695f; margin-top:.15rem; }
  .as-cursor { padding-top: 1rem; color: #5f6359; border-top: 1px solid #282b25; }.as-cursor span { color: var(--as-acid); animation: asBlink 1s steps(1) infinite; }
  .as-terminal-tag { position: absolute; right: -12px; bottom: -36px; background: var(--as-orange); color: white; padding: .65rem .9rem; border: 1px solid var(--as-ink); font: 600 .58rem var(--as-mono); letter-spacing: .08em; }
  .as-signal-grid { border-top: 1px solid var(--as-line); display: grid; grid-template-columns: repeat(4,1fr); }
  .as-signal-grid article { padding: 1.3rem 1.2rem 0; border-right: 1px solid var(--as-line); display:flex; gap:1rem; }.as-signal-grid article:last-child{border-right:0}.as-signal-grid strong{font:400 2rem var(--as-serif)}.as-signal-grid span{font:600 .58rem var(--as-mono);text-transform:uppercase;letter-spacing:.08em}.as-signal-grid p{font-size:.7rem;color:var(--as-subtle);margin:.25rem 0 0}

  .as-manifesto { border-top: 1px solid var(--as-ink); padding-top: 1.5rem; padding-bottom: clamp(6rem,10vw,10rem); display:grid; grid-template-columns:.45fr 1.3fr 1fr; gap:clamp(2rem,5vw,5rem); }
  .as-manifesto h2,.as-section-head h2,.as-feature h2,.as-cta h2 { font:400 clamp(2.7rem,5vw,5.2rem)/.98 var(--as-serif); letter-spacing:-.035em; margin:0; }
  .as-manifesto__body { padding-top: 3.4rem; }.as-manifesto__body p { line-height:1.8;color:var(--as-subtle);margin:0 0 1.2rem; }

  .as-workflow { padding-top: 2rem; padding-bottom: clamp(7rem,11vw,11rem); }
  .as-section-head { display:grid;grid-template-columns:1fr 1.35fr;gap:3rem;border-top:1px solid var(--as-ink);padding-top:1.4rem;margin-bottom:4rem}.as-section-head .as-eyebrow{margin-top:2.5rem}
  .as-flow-list { max-width:1000px;margin-left:auto; }.as-flow { display:grid;grid-template-columns:90px 1fr auto;min-height:180px;position:relative; }.as-flow__rail{display:flex;flex-direction:column;align-items:center;font:500 .75rem var(--as-mono)}.as-flow__rail span{background:var(--as-acid);color:var(--as-acid-ink);border:1px solid var(--as-ink);padding:.5rem}.as-flow__rail i{width:1px;flex:1;background:var(--as-ink)}.as-flow__content{border-top:1px solid var(--as-line);padding:0 2rem 3rem}.as-flow__content small{font:600 .6rem var(--as-mono);letter-spacing:.08em}.as-flow__content code{display:block;font:400 clamp(.8rem,1.4vw,1.05rem) var(--as-mono);background:var(--as-panel);color:var(--as-acid);padding:1rem 1.2rem;margin:1rem 0;width:fit-content;max-width:100%;overflow:auto}.as-flow__content p{color:var(--as-subtle)}.as-flow__step{font:400 4.5rem var(--as-serif);color:var(--as-ghost)}

  .as-feature { background:var(--as-panel);color:var(--as-panel-ink);max-width:none!important;padding:clamp(5rem,9vw,9rem) max(calc((100vw - 1240px)/2), 1.5rem);display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(4rem,9vw,9rem);position:relative }.as-feature:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px);background-size:100% 36px;pointer-events:none}.as-feature .as-section-number{color:var(--as-panel-faint)}.as-feature .as-eyebrow{margin-top:3rem;color:var(--as-acid)}.as-feature h2 span{color:var(--as-acid);font-family:var(--as-mono);font-size:.8em}.as-feature__statement>p:last-child{max-width:650px;line-height:1.8;color:var(--as-panel-muted);font-size:1.05rem;margin-top:2rem}.as-index-demo{border:1px solid #44463f;align-self:center;font-family:var(--as-mono);background:#151713;box-shadow:18px 18px 0 var(--as-acid)}.as-index-demo__head{display:grid;grid-template-columns:1fr 1fr;padding:.8rem 1rem;border-bottom:1px solid #44463f;font-size:.58rem;color:#9a9e92}.as-index-row{display:grid;grid-template-columns:55px 1fr 70px 50px;align-items:center;gap:.8rem;padding:.7rem 1rem;border-bottom:1px solid #292b26;font-size:.63rem}.as-index-row code{color:var(--as-acid)}.as-index-row i{height:1px;background:#44463f}.as-index-row b{color:var(--as-cyan)}.as-index-row.is-muted{opacity:.42}.as-index-row.is-muted b{color:#a0a39a}

  .as-docs { padding-top:clamp(6rem,10vw,10rem);padding-bottom:clamp(6rem,10vw,10rem) }.as-docs__grid{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--as-ink);border-left:1px solid var(--as-ink)}.as-doc-card{min-height:300px;padding:1.2rem;border-right:1px solid var(--as-ink);border-bottom:1px solid var(--as-ink);display:flex;flex-direction:column;transition:background .2s,transform .2s}.as-doc-card:hover{background:var(--as-acid);color:var(--as-acid-ink);transform:translateY(-7px)}.as-doc-card__top{display:flex;justify-content:space-between;font:600 .65rem var(--as-mono)}.as-doc-card small{font:600 .58rem var(--as-mono);letter-spacing:.08em;text-transform:uppercase;margin-top:auto}.as-doc-card h3{font:400 1.8rem/1 var(--as-serif);margin:.8rem 0}.as-doc-card p{font-size:.75rem;line-height:1.6;color:var(--as-subtle)}.as-doc-card:hover p{color:var(--as-acid-ink)}

  .as-cta { position:relative;border:1px solid var(--as-ink);padding:clamp(3rem,7vw,7rem);margin-bottom:5rem;background:var(--as-acid);color:var(--as-acid-ink);overflow:hidden }.as-cta__scan{position:absolute;right:-7%;top:-45%;width:45%;aspect-ratio:1;border:1px solid var(--as-acid-ink);border-radius:50%;box-shadow:0 0 0 35px var(--as-acid),0 0 0 36px var(--as-acid-ink),0 0 0 75px var(--as-acid),0 0 0 76px var(--as-acid-ink);opacity:.28}.as-cta h2{max-width:760px;margin-top:1.5rem}.as-cta>p{font-size:1rem;max-width:630px;line-height:1.7}.as-cta .as-button--primary{background:var(--as-acid-ink);color:#f2f0e8;border-color:var(--as-acid-ink);box-shadow:5px 5px 0 var(--as-orange)}

